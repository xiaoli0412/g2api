{
  "manifest_version": 3,
  "name": "Gemini Cookie Pusher",
  "version": "1.0.0",
  "description": "Automatically pushes Gemini cookies to gemini-web2api",
  "permissions": ["cookies", "alarms", "storage"],
  "host_permissions": [
    "https://gemini.google.com/*",
    "http://127.0.0.1:8081/*",
    "http://localhost:8081/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gemini Cookie Pusher"
  },
  "icons": {}
}
