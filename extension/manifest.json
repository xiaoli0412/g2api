{
  "manifest_version": 3,
  "name": "Gemini Cookie Pusher",
  "version": "1.2.0",
  "description": "Windows 11 Fluent-style Gemini cookie bridge for gemini-web2api",
  "permissions": [
    "cookies",
    "alarms",
    "storage",
    "activeTab",
    "webNavigation"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://*.google.com/*",
    "https://accounts.google.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gemini Cookie Pusher",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
