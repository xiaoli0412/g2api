{
  "manifest_version": 3,
  "name": "Gemini Cookie Pusher",
  "version": "1.0.0",
  "description": "Automatically extracts Gemini cookies and pushes to gemini-web2api server",
  "permissions": [
    "cookies",
    "alarms",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "http://127.0.0.1:8081/*",
    "http://localhost:8081/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gemini Cookie Pusher",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
