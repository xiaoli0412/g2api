<Page
    x:Class="Gemini2API.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="Transparent">

    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <Border Padding="24,20,24,24">
            <StackPanel MaxWidth="1080" Spacing="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Home" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Runtime health, endpoint state, and quick actions for the local Gemini2API backend." />
                    </StackPanel>
                    <CommandBar
                        Grid.Column="1"
                        Background="Transparent"
                        DefaultLabelPosition="Right">
                        <AppBarButton Label="Start server">
                            <AppBarButton.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE768;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Label="Stop server">
                            <AppBarButton.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71A;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Label="Dashboard">
                            <AppBarButton.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A7;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>
                </Grid>

                <muxc:InfoBar
                    IsOpen="True"
                    Severity="Informational"
                    Title="Native shell migration"
                    Message="The Windows app supervises the existing Python backend through local HTTP, so API behavior remains unchanged during the migration." />

                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Runtime" />
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Backend service" />
                                <TextBlock Grid.Column="1" Style="{StaticResource StatusPillTextStyle}" Text="Stopped" />
                                <TextBlock Grid.Row="1" Style="{StaticResource SecondaryTextStyle}" Text="Endpoint" />
                                <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource BodyTextStyle}" Text="http://127.0.0.1:18081" />
                                <TextBlock Grid.Row="2" Style="{StaticResource SecondaryTextStyle}" Text="Last probe" />
                                <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource BodyTextStyle}" Text="Not checked" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource SettingsCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Models" />
                            <TextBlock Style="{StaticResource PageTitleTextStyle}" FontSize="32" Text="12" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Available model aliases from /v1/models after the backend is running." />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource SettingsCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Backend contract" />
                            <TextBlock Style="{StaticResource BodyTextStyle}" Text="python -m gemini_web2api --config &lt;config&gt; --port &lt;port&gt;" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="The native UI launches this command, polls /, reads /admin/stats, and leaves Gemini compatibility inside the tested backend." />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Quick links" />
                            <Button HorizontalAlignment="Stretch" Content="Open config file" />
                            <Button HorizontalAlignment="Stretch" Content="Open extension folder" />
                            <Button HorizontalAlignment="Stretch" Content="Copy base URL" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
