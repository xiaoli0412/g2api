<Page
    x:Class="Gemini2API.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <Border Padding="24,20,24,24">
            <StackPanel MaxWidth="1080" Spacing="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Logs" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Backend stdout, stderr, health probes, and supervisor events." />
                    </StackPanel>
                    <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right">
                        <AppBarButton Label="Clear">
                            <AppBarButton.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE894;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Label="Save as">
                            <AppBarButton.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74E;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>
                </Grid>

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <ListView SelectionMode="None">
                        <ListViewItem>
                            <Grid MinHeight="40" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="00:00:00" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" Text="system" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Backend log stream is ready once the native supervisor starts a child process." />
                            </Grid>
                        </ListViewItem>
                    </ListView>
                </Border>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
