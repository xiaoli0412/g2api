<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#202020" Opacity="0.92" />
            <SolidColorBrush x:Key="AppSurfaceSolidBrush" Color="#202020" />
            <SolidColorBrush x:Key="AppLayerBrush" Color="#252525" Opacity="0.95" />
            <SolidColorBrush x:Key="AppHoverBrush" Color="#2D2D2D" />
            <SolidColorBrush x:Key="AppSelectedBrush" Color="#3B3B3B" />
            <SolidColorBrush x:Key="AppControlBrush" Color="#2B2B2B" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#333333" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="#E81123" />
            <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#999999" />
            <SolidColorBrush x:Key="AppDisabledTextBrush" Color="#666666" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <Style x:Key="SettingTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource AppSecondaryTextBrush}" />
    </Style>

    <Style x:Key="ColumnHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource AppSecondaryTextBrush}" />
    </Style>

    <Style x:Key="SettingsCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppLayerBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="CompactSettingsCardBorderStyle" TargetType="Border" BasedOn="{StaticResource SettingsCardBorderStyle}">
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style x:Key="TableHeaderBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,0,8,8" />
    </Style>

    <Style x:Key="StatusPillTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource AppSecondaryTextBrush}" />
    </Style>
</ResourceDictionary>
