<Window
    x:Class="Gemini2API.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid x:Name="Root" Background="Transparent">
        <Image
            x:Name="PersonalBackgroundImage"
            Stretch="UniformToFill"
            Opacity="0.18"
            Visibility="Collapsed" />

        <Rectangle
            Fill="{ThemeResource AppSurfaceBrush}"
            IsHitTestVisible="False" />

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Height="48"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <Border
                    Width="24"
                    Height="24"
                    Background="Transparent"
                    CornerRadius="4">
                    <Image
                        Width="22"
                        Height="22"
                        Source="ms-appx:///Assets/gemini-icon.png"
                        Stretch="Uniform" />
                </Border>
                <TextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="Gemini2API" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Margin="0,0,148,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Ellipse
                    x:Name="BackendStatusDot"
                    Width="8"
                    Height="8"
                    Fill="{ThemeResource AppDisabledTextBrush}" />
                <TextBlock
                    x:Name="BackendStatusText"
                    Foreground="{ThemeResource AppSecondaryTextBrush}"
                    FontSize="12"
                    Text="Stopped" />
            </StackPanel>
        </Grid>

        <muxc:NavigationView
            Grid.Row="1"
            x:Name="RootNavigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneOpen="False"
            IsPaneToggleButtonVisible="False"
            PaneDisplayMode="LeftCompact"
            CompactPaneLength="48"
            OpenPaneLength="48"
            SelectionChanged="RootNavigation_SelectionChanged">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Home" Tag="home">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE80F;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Server" Tag="server">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Cookies" Tag="cookies">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8D7;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Streaming" Tag="streaming">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE768;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Models" Tag="models">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE721;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Logs" Tag="logs">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Settings" Tag="settings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </muxc:NavigationView>
    </Grid>
</Window>
